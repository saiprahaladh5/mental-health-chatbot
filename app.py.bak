if bg_file is not None:
    data = bg_file.getvalue()
    _set_bg_from_bytes(data)
    try:
        with open("bg.bin","wb") as f: f.write(data)
    except Exception:
        pass
    st.session_state.bg_applied = True
elif not st.session_state.bg_applied:
    try:
        if os.path.exists("bg.bin"):
            with open("bg.bin","rb") as f: _set_bg_from_bytes(f.read())
            st.session_state.bg_applied = True
    except Exception:
        pass


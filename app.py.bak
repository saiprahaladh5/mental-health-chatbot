import base64, os
import streamlit as st

def _css(s:str): st.markdown(f"<style>{s}</style>", unsafe_allow_html=True)

def _aurora_canvas(blur=2, darken=0.45):
    _css(f"""
    :root{{--darken:{darken};}}
    [data-testid="stAppViewContainer"]{{background:transparent!important}}
    .stApp::before {{
      content:""; position:fixed; inset:0; z-index:-3;
      background:
        radial-gradient(40% 30% at 15% 10%, #60a5fa44 0%, transparent 70%),
        radial-gradient(35% 28% at 80% 15%, #22c55e44 0%, transparent 70%),
        radial-gradient(30% 40% at 50% 85%, #a78bfa40 0%, transparent 70%),
        linear-gradient(180deg, rgba(6,10,25,.60), rgba(6,10,25,.92));
      filter: blur({blur}px);
      transform: translateZ(0);
      animation: drift 18s ease-in-out infinite alternate;
    }}
    @keyframes drift {{
      0%  {{ filter: blur({blur}px) hue-rotate(0deg);    }}
      100%{{ filter: blur({blur+0.5}px) hue-rotate(8deg);}}
    }}
    /* subtle grain to avoid banding */
    .stApp::after {{
      content:""; position:fixed; inset:0; z-index:-2; pointer-events:none;
      background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.015) 0, rgba(255,255,255,.015) 2px, transparent 2px, transparent 4px);
      mix-blend-mode: overlay;
    }}
    """)

def _image_canvas(img_bytes:bytes, blur=2, darken=0.45):
    b64 = base64.b64encode(img_bytes).decode()
    _css(f"""
    :root{{--darken:{darken};}}
    [data-testid="stAppViewContainer"]{{background:transparent!important}}
    .stApp::before {{
      content:""; position:fixed; inset:0; z-index:-3;
      background:
        linear-gradient(rgba(8,12,24,var(--darken)), rgba(8,12,24,var(--darken))),
        url("data:image/jpeg;base64,{b64}") center / cover no-repeat fixed;
      filter: blur({blur}px); transform: scale(1.02);
    }}
    """)

def _video_canvas(video_bytes:bytes, darken=0.45, blur=2):
    b64 = base64.b64encode(video_bytes).decode()
    st.markdown(f"""
    <video id="bgvid" autoplay muted loop playsinline
           style="position:fixed;right:0;bottom:0;min-width:100%;min-height:100%;
                  z-index:-4;object-fit:cover;filter:brightness({1-darken}) blur({blur}px);">
      <source src="data:video/mp4;base64,{b64}" type="video/mp4">
    </video>
    """, unsafe_allow_html=True)

def apply_canvas():
    with st.sidebar.expander("Canvas", expanded=False):
        style = st.selectbox("Background style", ["Aurora","Image","Video"], index=0)
        if style=="Aurora":
            _aurora_canvas()
        elif style=="Image":
            img = st.file_uploader("Upload a wide image", type=["jpg","jpeg","png"])
            if img: _image_canvas(img.read())
            else:   _aurora_canvas()
        else:
            vid = st.file_uploader("Upload a short MP4/WebM", type=["mp4","webm"])
            if vid: _video_canvas(vid.read())
            else:   _aurora_canvas()

# Call once near the top of your app (after imports)
apply_canvas()
# ===== END BEAUTY CANVAS =====
